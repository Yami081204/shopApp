# Database and authentication (required)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecom_lipstick
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Local demo checkout. This does not create real bank transfers.
# Values: live (SePay automatic confirmation), manual (admin verifies), demo (simulation only).
VIETQR_MODE=demo

# Set these only when enabling real VietQR payments.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=

# Local email simulation. Use smtp only after configuring SMTP credentials.
EMAIL_MODE=demo
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
