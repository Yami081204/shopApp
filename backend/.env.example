# Set all three values to enable VietQR at checkout. Keep real account values
# in backend/.env; do not commit them.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=

# Values: live (SePay auto confirmation), manual (real QR + admin verification),
# demo (no real QR or money). Never use demo in production.
VIETQR_MODE=live

# Configure SePay to POST to https://<your-domain>/api/webhooks/sepay
# with Authorization: Apikey <same key>.
SEPAY_WEBHOOK_API_KEY=

# Use demo to simulate replies locally without real mailboxes or SMTP credentials.
# Use smtp to deliver real email; production defaults to smtp when EMAIL_MODE is unset.
EMAIL_MODE=demo

# Required only when EMAIL_MODE=smtp.
# SMTP_SECURE may be omitted; port 465 defaults to implicit TLS, other ports to STARTTLS.
# Use an app password when your email provider requires one. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
