{
  "name": "ecom-lipstick-backend",
  "version": "1.0.0",
  "description": "RESTful API backend for ecom-lipstick using Node.js and MySQL",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "db:migrate": "node migrations/run-migrations.js",
    "db:init": "node migrations/init-database.js",
    "db:seed:fashion": "node scripts/seed-fashion-products.js"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.1",
    "nodemailer": "^10.3.1",
    "sequelize": "^6.33.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
